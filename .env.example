# npm run quickstart copies this to .env and reads it. Other commands read only the real environment.
# Local FalkorDB by default. For one graph shared by several machines, use a FalkorDB Cloud URL:
# rediss://USERNAME:PASSWORD@HOST:PORT (see docs/CLOUD.md). The password is never printed.
FALKORDB_URL=redis://localhost:6379
# Optional: credentials kept out of the URL. The URL's own credentials win.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
SB_GRAPH=sb_demo
# The parsed repo on disk, re-parsed file by file on every edit. Empty = this checkout's demo-repo.
SB_REPO=
# 1 = the server also re-parses files a person saves, not only agent edits.
SB_WATCH=
# Editor paths under this directory are checked against the graph. Empty when
# the parsed repo is the checkout itself. SWITCHBOARD_OFF=1 disables the hooks.
SB_PREFIX=demo-repo
SERVER_PORT=8787
WEB_PORT=5173
# Optional (F20 briefing summary). Leave empty to disable.
ANTHROPIC_API_KEY=
