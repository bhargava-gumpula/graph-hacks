{
  "name": "switchboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "eslint .",
    "db:up": "docker compose up -d",
    "db:ping": "docker compose exec falkordb redis-cli GRAPH.QUERY sb_ping \"RETURN 1\"",
    "parse": "tsx scripts/parse.ts",
    "server": "tsx apps/server/src/index.ts",
    "web": "npm run dev -w @switchboard/web",
    "switchboard": "tsx packages/cli/src/index.ts",
    "scenario": "tsx scripts/scenario.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "bin": {
    "switchboard": "packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
